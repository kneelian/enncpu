; PGA utilities

; A has source
; B has target
; C has count
@MEMCPY_M
	PSHS D
	@MEMCPY_LOOP
		LDRB  D, A+
		STRB  D, B+
		SUB   C, #1
		JMNZO C, @MEMCPY_LOOP
	POPS D
	RET

; A has target
; B has byte
; C has count
@MEMSET_M
	CEQ   C, #0
	RET.P
	SUB   C, #1
	STRB  B, A+
	JMO @MEMSET_M

; A has source
; string must be zero-term
; return in A
@STRLEN_M
	PSHS B
	MOV  B, A
	MOV  A, #0
	PSHS C
	@STRLEN_LOOP
		LDRB  C, B+ 
		ADD   A, #1
		JMNZO C, @STRLEN_LOOP
	POPS C
	POPS B
	RET

; A has string x
; B has string y
; return in A
; 	0 if different
;   1 if equal
@STREQ_M
	PSHS C
	PSHS D
	@STREQ_L1
		LDRB  C, A+
		LDRB  D, B+

		; unequals
		CNE   C, D
		MOV.P A, #0
		JMO.P @STREQ_L1_E

		; reached the end?
		CEQ   C, #0
		MOV.P A, #1
		JMO.P @STREQ_L1_E

		JMO   @STREQ_L1
	@STREQ_L1_E
	POPS D
	POPS C
	RET

; A holds number to decimalise
; B holds pointer to string
;    where we want the result
;   (must be >= 9 bytes, for
;    8 chars of number + zero)
; avoids use of stack
@INT_TO_DEC_M
	PSHS C
	PSHS D
	PSHS E
	MOV  C, A
	MOV  D, #0
	MOV  E, #10
	@INT_TO_DEC_L1
		DIV   C, E
		ADD   D, #1
		JMNZO C, @INT_TO_DEC_L1
	; we know how many digits to reserve
	ADD  B, D  ; start from back
	MOV  D, #0
	STRB D, B-
	@INT_TO_DEC_L2
		MOV   C, A
		MOD   C, E
		ADD   C, '0'
		STRB  C, B-
		DIV   A, E
		JMNZO A, @INT_TO_DEC_L2
	POPS E
	POPS D
	POPS C
	RET

; A holds pointer to zero-term
; string with a decimal number
; (no error handling!)
@DEC_TO_INT_M
	PSHS B
	PSHS C
	PSHS D
	MOV  D, #10
	@DEC_TO_INT_L1
		LDRB B, A+
		JMZO B, @DEC_TO_INT_L1_E
		SUB  B, '0'
		MULA C, D
		ADD  C, B
		JMO  @DEC_TO_INT_L1
	@DEC_TO_INT_L1_E
	MOV  A, C
	POPS D
	POPS C
	POPS B
	RET

; A holds number to hexify
; B holds pointer to string
;    where we want the result
;   (must be >= 8 bytes, for
;    6 chars of number + 0x)
@INT_TO_HEX_M
	PSHS C
	PSHS D

	ADD  B, #7
	MOV  D, #6
	
	@INT_TO_HEX_L1
		MOV   C, A
		BAND  C, #0x0f
		CGT   C, #9
		ADD.P C, #7
		ADD   C, '0'
		STRB  C, B-
		LSHR  A, #4
		SUB   D, #1
		JMNZO D, @INT_TO_HEX_L1
	MOV  C, 'x'
	STRB C, B-
	MOV  C, '0'
	STRB C, B-

	POPS D
	POPS C
	RET

; A holds pointer to eight-byte
; string (doesn't have to be zero
; terminated) with a hex number
; prefixed with 0x (obligatory)
@HEX_TO_INT_M
	PSHS B
	PSHS C
	PSHS D
	ADD  A, #2 ; skip 0x
	MOV  B, #0
	MOV  C, #6
	@HEX_TO_INT_L1
		LSHL  B, #4
		LDRB  D, A+
		SUB   C, #1
		SUB   D, '0'
		CGT   D, #9
		SUB.P D, #7
		ADD   B, D
		JMNZO C, @HEX_TO_INT_L1
	MOV  A, B
	POPS D
	POPS C
	POPS B
	RET

; A has colour 16bpp
; B --> x
; C --> y
@DRAW_PX_M
	PSHS D
	PSHS E

	ADRL D, @FRAMEBUFFER
	ADRH D, @FRAMEBUFFER
	MOVL E, @FB_WIDTH
	MOVM E, @FB_WIDTH
	LSHL E, #1    ; bytes per row @ 16bpp

	LSHL B, #1
	MULA C, E
	ADD  D, C
	ADD  D, B

	STRW A, D

	POPS E
	POPS D
	RET

; A is char
; B --> x
; C --> y
@DRAW_CHAR_M
	PSHS D
	PSHS E
	PSHS F
	PSHS G

	ADRL D, @FRAMEBUFFER
	ADRH D, @FRAMEBUFFER
	MOVL E, @FB_WIDTH
	MOVM E, @FB_WIDTH
	LSHL E, #1    ; bytes per row @ 16bpp

	LSHL B, #1
	MULA C, E
	ADD  D, C
	ADD  D, B

	LSHL A, #4 ; offset in table
	ADRL B, @FONT16x8
	ADRM B, @FONT16x8
	ADD  B, A  ; position of bitmap in font

	MOV  C, D
	MOV  D, E
	MOV  E, #16
	@DRAW_OUTER
		MOV  F, #8
		LDRB G, B+  ; G now has full byte
		ADD  C, #16
		@DRAW_INNER
			MOV     A, G
			BAND    A, #1
			CEQ     A, #1
			LSHR    G, #1
			SUB.P   A, #1
			INV.P   A, A
			STRW.P  A, C
			SUB     C, #2
			; just skip bgcol bits
			SUB     F, #1
			JMNZO   F, @DRAW_INNER
		SUB   E, #1
		ADD   C, D  ; next row
		JMNZO E, @DRAW_OUTER
	POPS G
	POPS F
	POPS E
	POPS D
	RET

; takes pointer to zero terminated string in A
; prints until empty
@PRINT_STRING_M
	PSHS B
	MOV  B, A

	@PRINT_STRING_L1
		LDRB  A, B+
		JMZO  A, @PRINT_STRING_L1_E
	FAR JLO   @PUTCHAR_CURSOR
		JMO   @PRINT_STRING_L1
	@PRINT_STRING_L1_E

	POPS B
	RET

; print_next_char takes only a codepoint
; and handles the positioning of the char
; on the framebuffer by manipulating the
; "cursor" variables
@CURSOR_X
.INT8 0
@CURSOR_Y
.INT8 0
; screen is 80 chars wide (with 5 px on either side)
; and 25 tall 
; (640 / 8), (400 / 16)
;
; takes codepoint in A
@PUTCHAR_CURSOR_M
	PSHS B
	PSHS C
	PSHS D
	PSHS E

	ADRL  D, @CURSOR_X
	ADRM  D, @CURSOR_X
	ADRL  E, @CURSOR_Y
	ADRM  E, @CURSOR_Y

	LDRB  B, D
	LDRB  C, E

	LSHL B, #3  ; *8
	LSHL C, #4  ; *16

	ADD  B, #5  ; padding

 FAR JLO @DRAW_CHAR

	LDRB  B, D
	LDRB  C, E

 	ADD   B, #1
 	MOV   A, #80
 	CEQ   A, B    ; B ?= 80
 	MOV.P B, #0
 	ADD.P C, #1

 	STRB  B, D
	STRB  C, E

	POPS E
	POPS D
	POPS C
	POPS B
	RET

; A holds colour
@CLRSCR_M
	PSHS B
	PSHS C
	
	MOVL B, @FB_WIDTH
	MOVM B, @FB_WIDTH

	MOVL C, @FB_HEIGHT
	MOVM C, @FB_HEIGHT
	MULA C, B

	ADRL B, @FRAMEBUFFER
	ADRH B, @FRAMEBUFFER
	@CLRSCR_L1
		STRW  A, B+
		SUB   C, #1
		JMNZO C, @CLRSCR_L1

	POPS C
	POPS B
	RET

@DRAW_SPRITE_16x16_GRID_ALIGNED_M
	LSHL B, #4
	LSHL C, #4
; A contains pointer to sprite memory
; B contains X pos
; C contains Y pos
; 	a magenta pixel is transparent
;   i.e. 0xF81F is skipped
@DRAW_SPRITE_16x16_M
	PSHS D
	PSHS E
	PSHS F
	PSHS G

	ADD  B, #5 ; left padding

	ADRL D, @FRAMEBUFFER
	ADRH D, @FRAMEBUFFER
	MOVL E, @FB_WIDTH
	MOVM E, @FB_WIDTH
	LSHL E, #1    ; bytes per row @ 16bpp
	MULA C, E
	LSHL B, #1
	ADD  C, D
	ADD  C, B     ; top left
	_888_TO_565 G, 0xff, 0x00, 0xff, F
	; magenta in little endian now in G
	MOV  B, #16
	@DRAW_SPRITE_16x16_OUTER
		MOV  D, #16
		@DRAW_SPRITE_16x16_INNER
			LDRW   F, A+  ; has pixel
			CNE    F, G
			STRW.P F, C
			ADD    C, #2
			SUB    D, #1
			JMNZO  D, @DRAW_SPRITE_16x16_INNER
		SUB   C, #32
		ADD   C, E
		SUB   B, #1
		JMNZO B, @DRAW_SPRITE_16x16_OUTER
	POPS G
	POPS F
	POPS E
	POPS D
	RET

; returns hi24 in A
;         lo24 in B
@GET_TIMER_M
	PSHS C
	ADRL C, @EX_TIMER
	ADRM C, @EX_TIMER
	LDRS B, C+
	LDRS A, C
	POPS C
	RET

; A holds colour
; B holds x start
; C holds y start
; D holds nr of pixels
@DRAW_HLINE_M
	PSHS E
	PSHS F

	ADRL E, @FRAMEBUFFER
	ADRH E, @FRAMEBUFFER
	MOVL F, @FB_WIDTH
	MOVM F, @FB_WIDTH
	LSHL F, #1    ; bytes per row @ 16bpp

	LSHL B, #1
	MULA C, F
	ADD  E, C
	ADD  E, B

	@DRAW_HLINE_L1
		STRW  A, E+
		SUB   D, #1
		JMNZO D, @DRAW_HLINE_L1

	POPS F
	POPS E
	RET

; A holds colour
; B holds x start
; C holds y start
; D holds nr of pixels
@DRAW_VLINE_M
	PSHS E
	PSHS F

	ADRL E, @FRAMEBUFFER
	ADRH E, @FRAMEBUFFER
	MOVL F, @FB_WIDTH
	MOVM F, @FB_WIDTH
	LSHL F, #1    ; bytes per row @ 16bpp

	LSHL B, #1
	MULA C, F
	ADD  E, C
	ADD  E, B

	@DRAW_VLINE_L1
		STRW  A, E
		ADD   E, F
		SUB   D, #1
		JMNZO D, @DRAW_VLINE_L1

	POPS F
	POPS E
	RET

; A holds colour
; B holds x start
; C holds y start
; D holds x end
; E holds y end
@DRAW_RECT_M
	PSHS F
	PSHS G

	MOV  F, D
	SUB  F, B ; width
	MOV  G, E
	SUB  G, C ; height

	; (col, x, y, len) -> DRAW_HLINE
	SHDW B
	SHDW C
	SHDW D
	MOV  D, F
	JLA  @DRAW_HLINE
	LITE D
	LITE C
	LITE B

	MOV  D, F
	ADD  C, G
	JLA  @DRAW_HLINE
	LITE D
	LITE C
	LITE B

	MOV  D, G
	JLA  @DRAW_VLINE
	LITE D
	LITE C
	LITE B

	MOV  D, G
	ADD  B, F
	JLA  @DRAW_VLINE

	POPS G
	POPS F
	RET

@DRAW_RECT_FILL_M
	PSHS F
	PSHS G
	PSHS H

	MOV  F, D
	SUB  F, B ; width
	MOV  G, E
	SUB  G, C ; height

	; (col, x, y, len) -> DRAW_VLINE
	@DRAW_RECT_FILL_L1
		PSHS  B
		PSHS  C
		MOV   D, G
		JLA   @DRAW_VLINE
		POPS  C
		POPS  B

		ADD   B, #1
		SUB   F, #1
		JMNZO F, @DRAW_RECT_FILL_L1

	POPS H
	POPS G
	POPS F
	RET

; A contains device nr
; 	asks device to identify
;	if device missing or can't identify
;	returns -1 in A
; trashes B, C
@POLL_DEVICE_M
	MOV   B, #1 ; IDENTIFY()
	SYSCI #1
	RET

; A contains sector number
; B contains target address
@GET_SECTOR_M
	PSHS  C
	PSHS  D

	MOV   C, A
	MOV   D, B
	MOV   A, #0
	MOV   B, #3  ; GIVE_SECTOR()

	SYSCI #1

	POPS  D
	POPS  C
	RET