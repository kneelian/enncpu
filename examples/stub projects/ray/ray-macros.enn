$macro SAVEALL 0
	PSHS  A
	PSHS  B
	PSHS  C
	PSHS  D
	PSHS  E
	PSHS  F
	PSHS  G
	PSHS  H
	MOV.P A, #1
	PSHB  A
$endm

$macro LOADALL 0
	POPB A
	CEQ  A, #1 ; hack to preserve
	POPS H     ; predication state
	POPS G
	POPS F
	POPS E
	POPS D
	POPS C
	POPS B
	POPS A
$endm

$macro V3_OP_FP24 5
	m3 m0, m4
	m3 m1, m4
	m3 m2, m4
$endm

; m0 is the target reg
; m1 - m3 are the colours
; m4 is a temp register
$macro 888_TO_565 5
	MOV  m0, #0
	MOV  m4, #0
	
	MOVL m0, #m1 
	LSHR m0, #3
	BOR  m4, m0

	MOVL m0, #m2
	LSHR m0, #2
	LSHL m4, #6
	BOR  m4, m0

	MOVL m0, #m3
	LSHR m0, #3
	LSHL m4, #5
	BOR  m4, m0

	ENDW m0, m4
$endm